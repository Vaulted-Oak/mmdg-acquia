# Base URL of the Drupal site.
CANVAS_SITE_URL=https://example.com

# Credentials for Canvas CLI.
CANVAS_CLIENT_ID=cli
CANVAS_CLIENT_SECRET=secret

# Server credential for reading Source (public API access is off).
SOURCE_API_CLIENT_ID=
SOURCE_API_CLIENT_SECRET=

# Signs member session cookies. At least 32 random characters.
SESSION_SECRET=

# Shared password for the prototype's mock members.
DEMO_MEMBER_PASSWORD=
